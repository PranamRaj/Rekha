# Rekha configuration template.
#   cp .env.example .env     (Windows: copy .env.example .env)
#
# Real environment variables override this file; this file overrides the code
# defaults. Every value below is optional -- with no .env at all, Rekha runs on
# the defaults and the red-team numbers are unchanged.
#
# Loaded by rekha/config.py. Policy itself lives in rekha/manifests.yaml.

# ---------------------------------------------------------------- server
REKHA_HOST=127.0.0.1
REKHA_PORT=8000

# Live-demo database. WIPED AND RESEEDED on every start and on every /api/reset.
# Leave unset to use <system temp>/rekha_live.db. Use separate files if you want
# to run two servers at once.
# REKHA_DB_PATH=C:/Users/you/AppData/Local/Temp/rekha_live.db

# ---------------------------------------------------------------- approvers
# Demo token table: "token:approver_id" pairs. NOT real authentication -- a
# production deployment authenticates the human via SSO and never ships tokens
# in a file. Rotate these before showing the demo to anyone on a shared network.
REKHA_APPROVERS=tok-ops-priya:ops_priya,tok-fin-arun:fin_arun

# Which token the browser dashboard approves with (must appear above).
REKHA_DEMO_APPROVER_TOKEN=tok-ops-priya

# ---------------------------------------------------------------- lifetimes
REKHA_RECEIPT_TTL_SECONDS=300        # signed approval receipt validity
REKHA_SCOPE_TTL_SECONDS=3600         # session scope token validity
REKHA_RUBBER_STAMP_SECONDS=2.0       # approvals faster than this get flagged

# ---------------------------------------------------------------- policy overrides
# Normally leave these commented out so manifests.yaml stays the single source of
# truth. Uncomment to experiment -- the red-team invariants read the same values,
# so the suite stays self-consistent.
# REKHA_AUTO_MAX_PAISE=500000        # above this -> human review  (Rs 5,000)
# REKHA_CUSTOMER_24H_PAISE=500000    # rolling 24h automatic-refund cap per customer
# REKHA_VELOCITY_PER_HOUR=10         # refunds per session per hour
# REKHA_BULK_MAX=1                   # rows a destructive tool may touch unreviewed
# REKHA_BLOCKS_TO_QUARANTINE=3       # blocks before the session is quarantined
# REKHA_CANARY_UPI=canary.refunds@okaxis
# REKHA_POLICY_FILE=/path/to/manifests.yaml

# Simulated payment-API latency for config C2's check-then-act gap.
# REKHA_NAIVE_DELAY=0.05
